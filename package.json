{
  "name": "playwright-typescript-learning-framework",
  "version": "1.0.0",
  "private": true,
  "description": "A beginner-friendly Playwright and TypeScript login test framework.",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "test:trace": "playwright test --trace on",
    "report": "node scripts/open-latest.cjs",
    "test:sanity": "playwright test --grep @sanity",
    "test:regression": "playwright test --grep @regression --grep-invert @demo",
    "test:reporting": "node --test reporting/report-model.test.cjs",
    "test:universal": "node --test reporting/universal/test/schema.test.cjs reporting/universal/test/core.test.cjs reporting/universal/test/compatibility.test.cjs reporting/universal/test/evidence.test.cjs",
    "test:adapter": "node --test reporting/adapters/playwright/test/adapter.test.cjs",
    "test:junit": "node --test reporting/adapters/junit/test/parser.test.cjs reporting/adapters/junit/test/manifest.test.cjs reporting/adapters/junit/test/generate.test.cjs",
    "test:dashboard-evidence": "node --test reporting/dashboard-evidence.test.cjs",
    "test:package": "node --test reporting/package.test.cjs",
    "build:reporter": "rm -rf reporting/dist && tsc -p reporting/tsconfig.package.json && cp reporting/universal/schema/qa-report.schema.json reporting/dist/universal/schema/qa-report.schema.json",
    "report:junit": "node reporting/adapters/junit/cli.cjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "dotenv": "18.0.9",
    "typescript": "5.9.3"
  }
}
