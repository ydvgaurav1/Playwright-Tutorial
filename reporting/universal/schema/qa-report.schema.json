{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qa-report.local/schema/v1/qa-report.schema.json",
  "title": "Universal QA Report",
  "description": "Framework-independent execution result document. Artifact paths are relative to the run root.",
  "type": "object",
  "required": [
    "schemaVersion",
    "producer",
    "run",
    "environment",
    "capabilities",
    "tests",
    "globalErrors"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0.0" },
    "producer": { "$ref": "#/$defs/producer" },
    "run": { "$ref": "#/$defs/run" },
    "environment": { "$ref": "#/$defs/environment" },
    "labels": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "capabilities": { "$ref": "#/$defs/capabilities" },
    "externalReports": {
      "type": "array",
      "items": { "$ref": "#/$defs/externalReport" }
    },
    "tests": {
      "type": "array",
      "items": { "$ref": "#/$defs/test" }
    },
    "globalErrors": {
      "type": "array",
      "items": { "$ref": "#/$defs/error" }
    },
    "extensions": { "type": "object" }
  },
  "additionalProperties": true,
  "$defs": {
    "producer": {
      "type": "object",
      "required": ["name", "version", "framework"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "framework": { "type": "string", "minLength": 1 },
        "frameworkVersion": { "type": "string" },
        "sourceSchemaVersion": { "type": "string" }
      },
      "additionalProperties": true
    },
    "run": {
      "type": "object",
      "required": [
        "id",
        "status",
        "startedAt",
        "endedAt",
        "durationMs",
        "timezone"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": {
          "enum": ["passed", "failed", "timedOut", "interrupted", "unknown"]
        },
        "startedAt": { "type": "string", "format": "date-time" },
        "endedAt": { "type": "string", "format": "date-time" },
        "durationMs": { "type": "number", "minimum": 0 },
        "timezone": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "environment": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "baseUrl": { "type": "string" },
        "branch": { "type": "string" },
        "commit": { "type": "string" },
        "ci": { "type": "boolean" },
        "os": { "type": "string" },
        "runtime": { "type": "string" },
        "browsers": {
          "type": "array",
          "items": { "type": "string" }
        },
        "projects": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "capabilities": {
      "type": "object",
      "required": [
        "steps",
        "retries",
        "logs",
        "attachments",
        "traceFormats",
        "timings"
      ],
      "properties": {
        "steps": { "type": "boolean" },
        "retries": { "type": "boolean" },
        "logs": { "type": "boolean" },
        "attachments": { "type": "boolean" },
        "traceFormats": {
          "type": "array",
          "items": { "type": "string" }
        },
        "timings": { "enum": ["run", "test", "attempt"] }
      },
      "additionalProperties": true
    },
    "externalReport": {
      "type": "object",
      "required": ["label", "path"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "path": { "$ref": "#/$defs/safePath" },
        "kind": { "enum": ["html", "json", "xml", "other"] }
      },
      "additionalProperties": true
    },
    "safePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\0).+$"
    },
    "test": {
      "type": "object",
      "required": [
        "id",
        "title",
        "titlePath",
        "labels",
        "suites",
        "module",
        "spec",
        "source",
        "variant",
        "status",
        "durationMs",
        "retries",
        "attempts"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "nativeId": { "type": "string" },
        "idStrategy": { "type": "string" },
        "title": { "type": "string", "minLength": 1 },
        "titlePath": {
          "type": "array",
          "items": { "type": "string" }
        },
        "labels": {
          "type": "array",
          "items": { "type": "string" }
        },
        "suites": {
          "type": "array",
          "items": { "type": "string" }
        },
        "module": { "type": "string", "minLength": 1 },
        "spec": { "$ref": "#/$defs/spec" },
        "source": { "$ref": "#/$defs/source" },
        "variant": { "$ref": "#/$defs/variant" },
        "status": {
          "enum": [
            "passed",
            "failed",
            "skipped",
            "flaky",
            "timedOut",
            "interrupted",
            "unknown"
          ]
        },
        "durationMs": { "type": "number", "minimum": 0 },
        "retries": { "$ref": "#/$defs/retries" },
        "attempts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/attempt" }
        },
        "extensions": { "type": "object" }
      },
      "additionalProperties": true
    },
    "spec": {
      "type": "object",
      "required": ["key", "name", "path"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "source": {
      "type": "object",
      "required": ["file"],
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    },
    "variant": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "browser": { "type": "string" },
        "device": { "type": "string" },
        "repeat": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "retries": {
      "type": "object",
      "required": ["configured", "used"],
      "properties": {
        "configured": { "type": "integer", "minimum": 0 },
        "used": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "attempt": {
      "type": "object",
      "required": [
        "index",
        "retry",
        "status",
        "startedAt",
        "durationMs",
        "errors",
        "steps",
        "logs",
        "evidence"
      ],
      "properties": {
        "index": { "type": "integer", "minimum": 1 },
        "retry": { "type": "integer", "minimum": 0 },
        "status": {
          "enum": [
            "passed",
            "failed",
            "skipped",
            "timedOut",
            "interrupted",
            "unknown"
          ]
        },
        "startedAt": { "type": "string", "format": "date-time" },
        "durationMs": { "type": "number", "minimum": 0 },
        "executor": { "$ref": "#/$defs/executor" },
        "errors": {
          "type": "array",
          "items": { "$ref": "#/$defs/error" }
        },
        "steps": {
          "type": "array",
          "items": { "$ref": "#/$defs/step" }
        },
        "logs": {
          "type": "array",
          "items": { "$ref": "#/$defs/log" }
        },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" }
        },
        "extensions": { "type": "object" }
      },
      "additionalProperties": true
    },
    "executor": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "workerIndex": { "type": "integer", "minimum": 0 },
        "host": { "type": "string" }
      },
      "additionalProperties": true
    },
    "error": {
      "type": "object",
      "required": ["message"],
      "properties": {
        "message": { "type": "string", "minLength": 1 },
        "type": { "type": "string" },
        "stack": { "type": "string" },
        "snippet": { "type": "string" },
        "expected": { "type": "string" },
        "actual": { "type": "string" }
      },
      "additionalProperties": true
    },
    "step": {
      "type": "object",
      "required": [
        "title",
        "category",
        "status",
        "startedAt",
        "durationMs",
        "steps"
      ],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string" },
        "category": { "type": "string", "minLength": 1 },
        "status": { "enum": ["passed", "failed", "skipped"] },
        "startedAt": { "type": "string", "format": "date-time" },
        "durationMs": { "type": "number", "minimum": 0 },
        "error": { "$ref": "#/$defs/error" },
        "steps": {
          "type": "array",
          "items": { "$ref": "#/$defs/step" }
        }
      },
      "additionalProperties": true
    },
    "log": {
      "type": "object",
      "required": ["stream", "timestamp", "text"],
      "properties": {
        "stream": { "enum": ["stdout", "stderr", "system"] },
        "timestamp": { "type": "string", "format": "date-time" },
        "text": { "type": "string" },
        "truncated": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "required": ["kind", "name", "path"],
      "properties": {
        "kind": {
          "enum": [
            "screenshot",
            "video",
            "trace",
            "log",
            "file",
            "native-report"
          ]
        },
        "name": { "type": "string", "minLength": 1 },
        "path": { "$ref": "#/$defs/safePath" },
        "mimeType": { "type": "string" },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string" },
        "format": { "type": "string" },
        "missing": { "type": "boolean" }
      },
      "additionalProperties": true
    }
  }
}
